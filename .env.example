# ------------------------------------------------------------------
# Rumbo settings. Copy this file to ".env.local" and fill in values.
# NEVER commit .env.local — it holds secrets. It stays on the server.
# The app works WITHOUT any of these (demo mode with sample data).
# ------------------------------------------------------------------

# 1) Anthropic API key — turns on real AI web search and the AI Coach.
#    Get one at https://console.anthropic.com  (Settings → API Keys).
#    Tip: set a monthly spend limit in the Console as a second safety net.
ANTHROPIC_API_KEY=

# 2) Which Claude model to use (optional). Default: claude-opus-5-5 (best quality).
#    Cheaper options: claude-sonnet-5-5, claude-haiku-4-5.
#    You can also set one model per feature.
# AI_MODEL=claude-opus-5-5
# AI_MODEL_FINDER=
# AI_MODEL_COACH=
# AI_MODEL_TASKS=
# How hard the AI thinks: low | medium | high (lower = cheaper)
# AI_EFFORT_FINDER=medium
# AI_EFFORT_COACH=low
# AI_EFFORT_TASKS=low

# 3) Cost controls (optional)
# Searches per device per day:
# DAILY_SEARCH_LIMIT=15
# Coach messages per device per day:
# DAILY_CHAT_LIMIT=60
# Other AI tools (plans, flashcards, resume...) per device per day:
# DAILY_TASK_LIMIT=30
# Most the whole app may spend on AI per day, in US dollars:
# DAILY_BUDGET_USD=3

# 4) Database (optional). Leave empty to use a local SQLite file (prisma/dev.db).
#    For a permanent database online, use Postgres (e.g. Supabase or Neon) and run
#    `npm run db:use-postgres` once. Example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# 5) Secret used to scramble device IDs and IP addresses (any long random text).
HASH_SALT=change-me-to-something-long-and-random

# 6) Demo school codes for the People tab and staff tools (change for a real school).
# DEMO_STUDENT_CODE=RGV-STUDENT
# DEMO_STAFF_CODE=RGV-STAFF
# DEMO_PARENT_CODE=RGV-PARENT
# DEMO_MENTOR_CODE=RGV-MENTOR

# 7) Admin code for removing reported posts in the staff dashboard (optional).
# ADMIN_CODE=
